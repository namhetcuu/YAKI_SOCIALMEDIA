# Copy this file to .env and replace the placeholders.
# Spring Boot does not load .env automatically. Export these variables in your
# shell/IDE run configuration, or use a dotenv integration.

# Supabase Dashboard -> Connect -> Session pooler -> JDBC.
# Keep sslmode=require. URL-encode special characters if the password is put in the URL.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=mE$dnEq26@fG2Y.

# If you use Transaction pooler on port 6543 instead, JDBC prepared statements
# must be disabled:
# SUPABASE_DB_URL=jdbc:postgresql://POOLER_HOST:6543/postgres?sslmode=require&prepareThreshold=0

# Generate a random secret of at least 32 bytes for HS256 application JWTs.
JWT_SIGNER_KEY=replace-with-a-long-random-secret

# Optional: creates the initial "admin" account only when it does not exist.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Use update only while bootstrapping. Prefer validate after the schema is stable.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_POOL_SIZE=5
DB_MIN_IDLE=1
